 struct Mode {
   std::atomic<void (*)()> open{nullptr};
   std::atomic<bool (*)()> busy{nullptr};
+  std::atomic<bool (*)()> ready{nullptr};          // RegisterGate: false = en gris
+  std::atomic<const char* (*)()> why{nullptr};     // ... y lo que dice el bocadillo
 };
 Mode g_modes[kEntries];
 
@@ -404,12 +406,33 @@
   return false;
